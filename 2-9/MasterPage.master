<%@ Master Language="C#"
    CodeFile="MasterPage.master.cs"
    Inherits="MasterPage" %>

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head runat="server">
  <title>הספרייה שלי</title>
  <link href="css/StyleSheet.css" rel="stylesheet" />
  <script>
    function on(icon, pic)  { icon.src = "pics/menu/" + pic; }
    function off(icon, pic) { icon.src = "pics/menu/" + pic; }
  </script>
  <asp:ContentPlaceHolder id="head" runat="server" />
</head>
<body>
  <table>
    <tr>  <!-- כותרת עילית -->
      <td class="header">
        <img src="pics/header.jpg" style="width: 100%;" />
      </td>
    </tr>
    <tr>  <!-- תפריט ראשי -->
      <td class="nav">
        <a href="Home.aspx">
          <img src="pics/menu/home0.png" id="mHome" height="28" alt="דף הבית"
               onmouseover="on(mHome, 'home1.png')"
               onmouseout="off(mHome, 'home0.png')" />
        </a>
        <a href="Library.aspx">
          <img src="pics/menu/books0.png" id="mBooks" height="28" alt="ספרים"
               onmouseover="on(mBooks, 'books1.png')"
               onmouseout="off(mBooks, 'books0.png')" />
        </a>
        <a href="Timetable.aspx">
          <img src="pics/menu/calendar0.png" id="mTimetable" height="28" alt="מערכת שעות"
               onmouseover="on(mTimetable, 'calendar1.png')"
               onmouseout="off(mTimetable, 'calendar0.png')" />
        </a>
      </td>
    </tr>
    <tr>  <!-- כאן ייכנס התוכן של כל דף -->
      <td class="main">
        <asp:ContentPlaceHolder id="ContentPlaceHolder1"
            runat="server" />
      </td>
    </tr>
    <tr>  <!-- כותרת תחתונה -->
      <td class="footer"><h3>האתר נבנה על ידי משה</h3></td>
    </tr>
  </table>
</body>
</html>
